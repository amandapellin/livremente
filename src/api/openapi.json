{
  "openapi": "3.0.4",
  "info": {
    "title": "LivreMente.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "LivreMente.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Cria uma nova conta de usuário (RF01).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conta criada. Um e-mail de confirmação é enviado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "E-mail já cadastrado (RN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Autentica o usuário com e-mail e senha (RF02).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticado. Retorna o token e os dados do usuário.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Renova o token de acesso (RF02).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens renovados com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Gender": {
        "type": "string",
        "description": "Gênero informado no cadastro.",
        "enum": [
          "female",
          "male",
          "non_binary",
          "other",
          "prefer_not_to_say"
        ]
      },
      "ReadingLanguage": {
        "type": "string",
        "description": "Idioma de leitura de preferência.",
        "enum": [
          "pt",
          "en",
          "es",
          "fr",
          "ru"
        ]
      },
      "PublicationType": {
        "type": "string",
        "description": "Tipo de publicação de interesse (obra: livro ou artigo).",
        "enum": [
          "book",
          "scientific_article"
        ]
      },
      "RegisterPreferences": {
        "type": "object",
        "description": "Preferências de leitura usadas para gerar recomendações. Opcionais no cadastro.",
        "properties": {
          "languages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReadingLanguage"
            }
          },
          "publications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicationType"
            }
          },
          "categories": {
            "type": "array",
            "description": "Categorias de livros e/ou áreas de artigos (slugs).",
            "items": {
              "type": "string"
            }
          },
          "literaryGenres": {
            "type": "array",
            "description": "Gêneros literários (slugs), aplicáveis a livros.",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password",
          "birthDate",
          "gender",
          "lgpdConsent"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "Nome completo."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "description": "Data de nascimento no formato ISO (YYYY-MM-DD)."
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "preferences": {
            "$ref": "#/components/schemas/RegisterPreferences"
          },
          "lgpdConsent": {
            "type": "boolean",
            "description": "Consentimento LGPD (RN03). Obrigatório e deve ser true."
          },
          "marketingConsent": {
            "type": "boolean",
            "description": "Aceite opcional de avisos sobre novas obras."
          }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "Mensagem amigável para exibição."
          },
          "code": {
            "type": "string",
            "description": "Código estável do erro (ex.: EMAIL_ALREADY_EXISTS)."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "maxLength": 128
          },
          "rememberMe": {
            "type": "boolean",
            "description": "Mantém o usuário conectado entre sessões (RF02)."
          }
        }
      },
      "AuthUser": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "token",
          "refreshToken",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Token de acesso (JWT) a ser enviado no header Authorization."
          },
          "refreshToken": {
            "type": "string",
            "description": "Token de atualização (Refresh Token) para renovar a sessão."
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Token de atualização (Refresh Token) atual."
          }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "required": [
          "token",
          "refreshToken"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Novo token de acesso (JWT)."
          },
          "refreshToken": {
            "type": "string",
            "description": "Novo token de atualização (Refresh Token)."
          }
        }
      }
    }
  }
}
